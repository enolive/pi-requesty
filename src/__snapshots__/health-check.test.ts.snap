exports[`checkModels > calls basic and reasoning/tool check for reasoning models 1`] = `
[
  {
    "max_tokens": 16,
    "messages": [
      {
        "content": "Say OK",
        "role": "user",
      },
    ],
    "model": "requesty/reasoning-model",
    "stream": true,
  },
  {
    "messages": [
      {
        "content": "Say OK. Do not call any tools.",
        "role": "user",
      },
    ],
    "model": "requesty/reasoning-model",
    "reasoning_effort": "low",
    "stream": true,
    "tools": [
      {
        "function": {
          "description": "A no-op tool used only to verify tool compatibility during model health checks.",
          "name": "health_check_noop",
          "parameters": {
            "additionalProperties": false,
            "properties": {},
            "type": "object",
          },
        },
        "type": "function",
      },
    ],
  },
]
`;

exports[`checkModels > calls basic completion check once per model 1`] = `
