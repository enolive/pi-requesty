]
`;

exports[`health summary and log output > formats summaries 1`] = `
{
  "allFailed": "Health check: 0 OK, 2 failed.",
  "allPassed": "Health check: 2 OK.",
  "mixed": "Health check: 1 OK, 1 warning, 1 failed.",
  "onlyWarnings": "Health check: 0 OK, 2 warnings.",
  "partialFailure": "Health check: 1 OK, 1 failed.",
  "withWarnings": "Health check: 2 OK, 1 warning.",
}
`;

exports[`health summary and log output > writes added and removed models into the log 1`] = `
"Requesty health check log
Timestamp: <timestamp>
Provider: requesty-export
Base URL: https://router.requesty.ai/v1
Total: 1
Passed: 1
Warnings: 0
Failed: 0
Banned: 0

Added models:
- requesty/model-a
- requesty/model-new
Removed models:
- requesty/model-old

No failed models.
"
`;

