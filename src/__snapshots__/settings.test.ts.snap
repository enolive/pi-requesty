// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`readDiscoverySettings > returns default settings and writes a commented default file when none exists 1`] = `
"{
  $schema: "https://raw.githubusercontent.com/enolive/pi-requesty/main/docs/requesty-discovery-settings.schema.json",
  // the provider id in models.json whose models are managed by this extension
  providerId: "requesty-export",
  // health check mode: "full" (basic + reasoning/tool check), "basic", or "off"
  healthCheckMode: "full",
  // models excluded from discovery; useful for models that keep failing health checks
  bannedModels: []
}
"
`;
