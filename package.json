{
  "name": "pi-requesty-discover",
  "version": "3.0.1",
  "description": "Discover available Requesty models for the Pi Coding Agent",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enolive/pi-requesty-discover.git"
  },
  "homepage": "https://github.com/enolive/pi-requesty-discover",
  "bugs": {
    "url": "https://github.com/enolive/pi-requesty-discover/issues"
  },
  "type": "module",
  "main": "src/index.ts",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extensions",
    "requesty",
    "openai-compatible",
    "models"
  ],
  "scripts": {
    "check": "npm run agent-lint && npm run format:check && npm run typecheck && npm run lint",
    "agent-lint": "agnix . -v --strict",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "release": "read -p 'Release a new version? [y/N] ' ok && [ \"$ok\" = \"y\" ] && npm version patch && git push --follow-tags",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:unit:coverage": "vitest run src --coverage",
    "test:integration": "vitest run test/integration.test.ts",
    "test:watch": "vitest",
    "prepack": "downdoc README.adoc"
  },
  "license": "MIT",
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "^0.85.0",
    "@earendil-works/pi-coding-agent": "^0.85.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.9",
    "agnix": "^0.37.0",
    "downdoc": "^1.1.0-stable",
    "eslint": "^10.6.0",
    "globals": "^17.7.0",
    "jiti": "^2.7.0",
    "msw": "^2.14.6",
    "prettier": "^3.9.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "json5": "^2.2.3",
    "zod": "^4.4.3"
  }
}
